:{$PORT:8080} {
    root * /srv

    # Keep the public origin aligned with the demo app's frame-ancestors CSP.
    @apex host konote.ca
    redir @apex https://www.konote.ca{uri} permanent

    # French demo embeds: proxy to the demo app with an explicit language header.
    handle /fr/embed/register-demo/ {
        rewrite * /register/demo/?embed=1
        reverse_proxy https://demo.konote.ca {
            header_up Host demo.konote.ca
            header_up Accept-Language fr
        }
    }

    handle /fr/embed/demo-program-feedback/ {
        rewrite * /s/demo-program-feedback/?embed=1
        reverse_proxy https://demo.konote.ca {
            header_up Host demo.konote.ca
            header_up Accept-Language fr
        }
    }

    # Assets referenced by proxied demo embed pages.
    handle /static/* {
        reverse_proxy https://demo.konote.ca {
            header_up Host demo.konote.ca
        }
    }

    # Root URL: detect browser language preference
    @root path /
    handle @root {
        @french header_regexp Accept-Language (?i)fr
        redir @french /fr/ temporary
        redir * /en/ temporary
    }

    # Shared static assets (CSS, JS, images, favicons)
    @static path /css/* /js/* /img/* /favicon* /robots.txt /sitemap.xml
    handle @static {
        file_server
    }

    # Custom 404 pages per language subtree
    handle /en/* {
        try_files {path} {path}/index.html /en/404.html
        file_server
    }

    handle /fr/* {
        try_files {path} {path}/index.html /fr/404.html
        file_server
    }

    # Fallback for any other path
    handle {
        redir * /en/ temporary
    }

    encode gzip
}
